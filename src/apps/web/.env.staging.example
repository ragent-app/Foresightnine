# Public staging API only; never place provider or OAuth secrets in Vite env.
VITE_FORESIGHTNINE_API_BASE_URL=https://api-staging.foresightnine.com

# The API is a controlled edge adapter. It returns explicit limited_data when
# licensed factor/FX fields are unavailable; the client keeps FM calculations local.
VITE_FORESIGHTNINE_MARKET_DATA_MODE=public
VITE_FORESIGHTNINE_MARKET_DATA_BASE_URL=https://api-staging.foresightnine.com

# Optional only when a deployment-owned Android release certificate exists.
# Leave blank for staging; the build then publishes [] so SPA fallback cannot
# masquerade as an App Link declaration. Production builds fail closed unless
# this is the real certificate fingerprint (never a debug/QA fingerprint).
VITE_FORESIGHTNINE_ANDROID_APP_LINK_PACKAGE=com.foresightnine.mobile
VITE_FORESIGHTNINE_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=
