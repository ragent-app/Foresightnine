 "evidence_requirements": [
  {
   "id": "entity",
   "description": "Issuer, CIK, SIC (gate/L2 KPI), currency, fiscal calendar.",
   "preferred_tools": [
    "resolve_entity"
   ],
   "required": true,
   "freshness": "n/a",
   "acceptance": "unique id",
   "fallback": "Mark id unverified."
  },
  {
   "id": "statements",
   "description": "3-statement & R*.htm segment/note tables (2 periods).",
   "preferred_tools": [
    "sec_filing_tables",
    "company_financials",
    "filings",
    "issuer_documents",
    "extract_statements",
    "news_search"
   ],
   "required": true,
   "freshness": "latest <= clock",
   "acceptance": "period, unit, currency",
   "fallback": "Filing text only; mark non-standard."
  },
  {
   "id": "filing_text",
   "description": "Dual 8-K 99.1, 10-Q/K sections, redline & CIK EFTS.",
   "preferred_tools": [
    "sec_earnings_release",
    "sec_filing_sections",
    "sec_redline_diff",
    "sec_fulltext_search",
    "filings",
    "issuer_documents",
    "acquire_sources",
    "read_pages",
    "search_source"
   ],
   "required": true,
   "freshness": "latest <= clock",
   "acceptance": "quoted via record_facts",
   "fallback": "Note text missing; no memory figures."
  },
  {
   "id": "prior_compare",
   "description": "Deterministic YoY/QoQ growth & margin deltas.",
   "preferred_tools": [
    "calculate_financials"
   ],
   "required": true,
   "freshness": "same",
   "acceptance": "calculated deltas",
   "fallback": "Compute explicitly; mark unaudited."
  },
  {
   "id": "diagnostics_and_valuation",
   "description": "R/Y/G quality flags, guidance/Non-GAAP tie, multiples & Reverse-DCF.",
   "preferred_tools": [
    "earnings_quality_diagnostics",
    "guidance_and_nongaap_reconciler",
    "valuation_and_implied_expectations",
    "market_data"
   ],
   "required": false,
   "freshness": "last session",
   "acceptance": "Decimal tie; degrade FCF<=0",
   "fallback": "Omit DCF; news NOT market data."
  },
  {
   "id": "consensus_and_transcript",
   "description": "Consensus vs actuals & call remarks/Q&A.",
   "preferred_tools": [
    "earnings_consensus",
    "earnings_transcript"
   ],
   "required": false,
   "freshness": "latest call",
   "acceptance": "BYOK/gaps noted",
   "fallback": "Use 8-K 99.1 guidance; prompt upload."
  },
  {
   "id": "context",
   "description": "Independent commentary.",
   "preferred_tools": [
    "search_library",
    "news_search"
   ],
   "required": false,
   "freshness": "pre-clock",
   "acceptance": "independent",
   "fallback": "Note unsearched."
  }
 ],
 "counter_evidence": {
  "look_for": [
   "NO generic macro platitudes; anchor bear case to R/Y flag, redline, guidance/Non-GAAP gap, or Reverse-DCF mismatch + next-Q trigger",
   "OCF/NI or FCF ex-SBC lag, AR/inv gap, SBC dilution, recurring add-backs"
  ],
  "min_search_actions": 1,
  "if_none_found": "List searched sections; none found."
 },
 "unit_and_period_checks": [
  "fiscal/calendar & 52/53-wk",
  "Decimal scale/currency",
  "GAAP vs Non-GAAP; FCF ex-SBC",
  "YoY/QoQ & diluted shares",
  "SIC gate"
 ],
 "reconciliation": [
  {
   "metric": "rev, NI, EPS",
   "source_classes": [
    "structured",
    "filing"
   ],
   "note": "tie after scale"
  },
  {
   "metric": "Non-GAAP & guidance",
   "source_classes": [
    "8-K 99.1",
    "consensus"
   ],
   "note": "verify add-backs; note gaps"
  }
 ],
 "stopping_conditions": [
  "filings, diagnostics, guidance/Non-GAAP & valuation (or degradations) done",
  "anchored bear cases w/ next-Q trigger; missing filing stops w/ gap"
 ],
 "report_structure": {
  "sections": [
   "Summary & Expectations Gap (Guidance/Non-GAAP)",
   "Earnings Quality & Cash Forensics (R/Y/G)",
   "Multi-Period Trends, Segments & KPIs",
   "Cross-Period Redline & Policy Changes",
   "Valuation Multiples & Reverse-DCF",
   "Anchored Bear Case (w/ Next-Q Trigger) & Gaps"
  ],
  "must_state": [
   "as-of dates, clock & SIC gate",
   "coverage gaps (consensus/transcript, FCF<=0 DCF)",
   "calculated vs quoted; bear anchor + trigger"
  ]
 },
 "limits": [
  "degrade w/o FMP (8-K fallback) or when FCF<=0 (no DCF)",
  "no generic macro bear platitudes w/o filing/numeric anchor"
 ]
}
