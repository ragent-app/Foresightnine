{
  "expo": {
    "name": "ForesightNine",
    "slug": "foresightnine-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "foresightnine",
    "android": {
      "package": "com.foresightnine.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#f7f2e9"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain", "text/uri-list"],
            "multipleShareMimeTypes": []
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
