            "quotation_match": "whitespace_normalized",
            "support_status": "not_independently_verified",
            "quotation": "Near-term risks to the economic outlook appear roughly balanced, but the Committee is\nmonitoring inflation developments closely."
          }
        ],
        "support_status": "not_independently_verified",
        "role": "support",
        "uncited_percentage_bounds": [
