            "quotation_match": "whitespace_normalized",
            "support_status": "not_independently_verified",
            "quotation": "raise the\ninterest rate paid on reserve balances to 4.65 percent, effective February 2, 2023."
          }
        ],
        "support_status": "not_independently_verified",
        "role": "support",
        "support_review": {
          "verdict": "does_not_support",
          "method": "bounded_quotation_context_model_review_v23_isolated",
          "independently_verified": false
