            "support_status": "not_independently_verified",
            "quotation": "Current-dollar estimates are valued in the prices of the\nperiod when the transactions occurred—that is, at “market\nvalue.” Also referred to as “nominal estimates” or as\n“current-price estimates.”"
          }
