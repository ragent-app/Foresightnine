{
  "name": "@foresightnine/asset-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry/v1/assets.json": "./registry/v1/assets.json"
  },
  "scripts": {
