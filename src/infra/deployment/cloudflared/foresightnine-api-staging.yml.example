# Copy to the host's cloudflared config directory and keep the credentials
# file outside Git with mode 600.
tunnel: b3a095a8-b1a7-4dcc-b452-9a9cd83cd5a4
credentials-file: /etc/cloudflared/b3a095a8-b1a7-4dcc-b452-9a9cd83cd5a4.json
protocol: http2

ingress:
  # The public apex is a canonical redirect entry handled by the API host middleware.
  - hostname: foresightnine.com
    service: http://127.0.0.1:8000
  - hostname: www.foresightnine.com
    service: http://127.0.0.1:8000
  # The unified app host serves Web plus API callback/API paths.
  - hostname: app.foresightnine.com
    path: ^/metrics$
    service: http_status:404
  - hostname: app.foresightnine.com
    path: ^/readyz$
    service: http://127.0.0.1:8000
  - hostname: app.foresightnine.com
    path: '^/oauth/complete(/.*)?$'
    service: http://127.0.0.1:4173
    originRequest:
      httpHostHeader: 127.0.0.1:4173
  - hostname: app.foresightnine.com
    path: '^/(api|oauth|v1|snapshots)(/.*)?$'
    service: http://127.0.0.1:8000
  - hostname: app.foresightnine.com
    path: '^/(health|docs|openapi\.json)(/.*)?$'
    service: http://127.0.0.1:8000
  - hostname: app.foresightnine.com
    service: http://127.0.0.1:4173
    originRequest:
      httpHostHeader: 127.0.0.1:4173

  # Metrics are for a local supervisor/Prometheus only, never a public route.
  - hostname: api-staging.foresightnine.com
    path: ^/metrics$
    service: http_status:404
  - hostname: api-staging.foresightnine.com
    service: http://127.0.0.1:8000

  # staging is Web-only; API-shaped paths must not become HTML 200s.
  - hostname: staging.foresightnine.com
    path: '^/(api|v1)(/.*)?$'
    service: http_status:404
  - hostname: staging.foresightnine.com
    path: '^/(health|readyz|metrics)$'
    service: http_status:404
  - hostname: staging.foresightnine.com
    service: http://127.0.0.1:4173
  - service: http_status:404

originRequest:
  connectTimeout: 10s
  noTLSVerify: false
