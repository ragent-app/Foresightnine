FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

# OCR: Tesseract with eng (default) plus common CJK/European packs; more packs can be added per deployment.
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils util-linux \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
        tesseract-ocr-jpn tesseract-ocr-kor tesseract-ocr-deu tesseract-ocr-fra \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api/pyproject.toml apps/api/README.md apps/api/uv.lock /app/apps/api/
COPY apps/api/app /app/apps/api/app
COPY packages/contracts/schemas /app/packages/contracts/schemas
COPY packages/asset-registry /app/packages/asset-registry
COPY infra/migrations /app/infra/migrations
COPY infra/deployment/provider-manifest.v1.json /app/infra/deployment/provider-manifest.v1.json
RUN uv sync --project /app/apps/api --frozen --no-dev --no-install-project

ENV MALLOC_ARENA_MAX=2 MALLOC_MMAP_THRESHOLD_=131072
EXPOSE 8000
CMD ["/app/apps/api/.venv/bin/python", "-m", "uvicorn", "app.main:app", "--app-dir", "/app/apps/api", "--host", "0.0.0.0", "--port", "8000"]
