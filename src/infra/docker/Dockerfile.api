FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
COPY apps/api/pyproject.toml apps/api/README.md apps/api/uv.lock /app/apps/api/
COPY apps/api/app /app/apps/api/app
COPY packages/contracts/schemas /app/packages/contracts/schemas
COPY packages/asset-registry /app/packages/asset-registry
COPY infra/migrations /app/infra/migrations
RUN uv sync --project /app/apps/api --frozen --no-dev --no-install-project

EXPOSE 8000
CMD ["uv", "run", "--project", "/app/apps/api", "uvicorn", "app.main:app", "--app-dir", "/app/apps/api", "--host", "0.0.0.0", "--port", "8000"]
