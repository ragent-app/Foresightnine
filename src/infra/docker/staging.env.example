# ForesightNine staging deployment secrets template. Copy to staging.env and fill values.
# (c) injected via compose env_file on the Linux staging host only.

# --- Persistent services (keep the real password only in staging.env) ---
FORESIGHTNINE_POSTGRES_PASSWORD=
FORESIGHTNINE_POSTGRES_URL=postgresql://foresightnine:<password>@postgres:5432/foresightnine

# --- OAuth (fill the 4 credential values from the provider consoles) ---
# Registered redirect URI at Google/GitHub MUST be exactly:
#   https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_CALLBACK_BASE_URL=https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_RETURN_URI_ALLOWLIST=https://staging.foresightnine.com/oauth/mobile-callback,foresightnine://oauth/complete
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_ID=
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_SECRET=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_ID=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_SECRET=

# --- Model wire protocol (server-side credentials only) ---
# Replace these placeholders with an authorized deployment and its matching host.
FORESIGHTNINE_LLM_PROVIDER=openai_chat_completions
FORESIGHTNINE_LLM_BASE_URL=https://example.test/v1
FORESIGHTNINE_LLM_MODEL=example-deployment
FORESIGHTNINE_LLM_ALLOWED_HOSTS=example.test
# Request timeout is a transport boundary, not a research run budget.
FORESIGHTNINE_LLM_TIMEOUT_SECONDS=120
# Set native_tools true only after verifying support for this exact deployment.
# The endpoint is the full chat completions URL. Unknown capability fails closed.
FORESIGHTNINE_LLM_ENDPOINT_VERSION=deployment-v1
FORESIGHTNINE_LLM_CAPABILITY_PROFILE='{"endpoint":"https://example.test/v1/chat/completions","model":"example-deployment","version":"deployment-v1","mode":"json_object","native_tools":true,"generation_parameters":["temperature"],"continuation":false}'
# Values are sent only for parameter names explicitly allowed by the profile.
# Private extensions may likewise be explicitly named when supported.
FORESIGHTNINE_LLM_GENERATION_PARAMETERS='{"temperature":0.2}'
# For a protocol requiring an opaque assistant continuation field, set
# continuation=true and continuation_fields to the verified field names.
# Do not include sensitive reasoning fields unless needed for continuation.
# Research model/search/token/time/cost budgets are optional request settings.
# Absent budgets are not automatically assigned. Model capacity is unknown
# unless supported by an exact endpoint/model/version capability profile.
# Optional model-call business quota; unset disables it, zero blocks calls.
# FORESIGHTNINE_MODEL_CALL_QUOTA=0
FORESIGHTNINE_LLM_API_KEY=
# Account-owned BYOK credentials are encrypted with this independently rotated
# deployment secret; without it personal mode fails closed.
FORESIGHTNINE_MODEL_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/foresightnine-model-credential-encryption.key

# --- Android App Link (production release certificate) ---
FORESIGHTNINE_ANDROID_APP_LINK_PACKAGE=com.foresightnine.mobile
FORESIGHTNINE_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AA:BB:...:CC (release cert SHA-256)

# --- Market data providers (optional licensed server keys; fail closed when empty) ---
FORESIGHTNINE_MARKET_CONSENSUS_MODE=priority
FORESIGHTNINE_STOOQ_API_KEY=
FORESIGHTNINE_MARKETDATA_API_KEY=
FORESIGHTNINE_ALPHAVANTAGE_API_KEY=
# Optional comma-separated rotation set for server-side Alpha Vantage keys.
FORESIGHTNINE_ALPHAVANTAGE_API_KEYS=
FORESIGHTNINE_TWELVEDATA_API_KEY=
FORESIGHTNINE_FINNHUB_API_KEY=
# Mounted file path only; the key material stays outside the repository.
FORESIGHTNINE_MARKET_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/foresightnine-market-credential-encryption.key

# Optional independent Messages research deployment. Leave protocol unset for
# existing Chat routing. All placeholders must be replaced before enabling.
# FORESIGHTNINE_RESEARCH_MODEL_PROTOCOL=anthropic_messages
# FORESIGHTNINE_RESEARCH_LLM_BASE_URL=https://research-model.example/v1
# FORESIGHTNINE_RESEARCH_LLM_MODEL=deployment-model-id
# FORESIGHTNINE_RESEARCH_LLM_API_KEY=inject-from-secret-store
# FORESIGHTNINE_RESEARCH_LLM_ALLOWED_HOSTS=research-model.example
# FORESIGHTNINE_RESEARCH_LLM_CREDENTIAL_REVISION=credential-version
# FORESIGHTNINE_RESEARCH_LLM_TIMEOUT_SECONDS=20
# FORESIGHTNINE_RESEARCH_MAX_OUTPUT_TOKENS=1024
# FORESIGHTNINE_MESSAGES_VERSION=protocol-version
# FORESIGHTNINE_MESSAGES_AUTH_SCHEME=bearer
# FORESIGHTNINE_MESSAGES_NATIVE_TOOLS=true
# FORESIGHTNINE_MESSAGES_CONTINUATION=true
# Capability declaration must match exact configured endpoint, model and version.
# FORESIGHTNINE_MESSAGES_CAPABILITY_BASE_URL=https://research-model.example/v1
# FORESIGHTNINE_MESSAGES_CAPABILITY_MODEL=deployment-model-id
# FORESIGHTNINE_MESSAGES_CAPABILITY_VERSION=protocol-version
# Optional exact personal endpoint permission; capability match still required.
# FORESIGHTNINE_MESSAGES_PERSONAL_BASE_URL=https://research-model.example/v1
