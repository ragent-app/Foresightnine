# ForesightNine staging deployment secrets template. Copy to staging.env and fill values.
# (c) injected via compose env_file on the Linux staging host only.

# --- Persistent services (keep the real password only in staging.env) ---
FORESIGHTNINE_POSTGRES_PASSWORD=
FORESIGHTNINE_POSTGRES_URL=postgresql://foresightnine:<password>@postgres:5432/foresightnine

# --- OAuth (fill the 4 credential values from the provider consoles) ---
# Registered redirect URI at Google/GitHub MUST be exactly:
#   https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_CALLBACK_BASE_URL=https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_RETURN_URI_ALLOWLIST=https://staging.foresightnine.com/oauth/mobile-callback,foresightnine://oauth/complete
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_ID=
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_SECRET=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_ID=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_SECRET=

# --- LLM (GLM coding endpoint, fixed model glm-5.3) ---
FORESIGHTNINE_GLM_CODING_API_KEY=

# --- Android App Link (production release certificate) ---
FORESIGHTNINE_ANDROID_APP_LINK_PACKAGE=com.foresightnine.mobile
FORESIGHTNINE_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AA:BB:...:CC (release cert SHA-256)

# --- Market data providers (optional licensed server keys; fail closed when empty) ---
FORESIGHTNINE_MARKET_CONSENSUS_MODE=priority
FORESIGHTNINE_STOOQ_API_KEY=
FORESIGHTNINE_MARKETDATA_API_KEY=
FORESIGHTNINE_ALPHAVANTAGE_API_KEY=
# Optional comma-separated rotation set for server-side Alpha Vantage keys.
FORESIGHTNINE_ALPHAVANTAGE_API_KEYS=
FORESIGHTNINE_TWELVEDATA_API_KEY=
FORESIGHTNINE_FINNHUB_API_KEY=
