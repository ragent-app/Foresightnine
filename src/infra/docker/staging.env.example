# ForesightNine staging deployment secrets template. Copy to staging.env and fill values.
# (c) injected via compose env_file on the Linux staging host only.

# --- Persistent services (keep the real password only in staging.env) ---
FORESIGHTNINE_POSTGRES_PASSWORD=
FORESIGHTNINE_POSTGRES_URL=postgresql://foresightnine:<password>@postgres:5432/foresightnine

# --- OAuth (fill the 4 credential values from the provider consoles) ---
# Registered redirect URI at Google/GitHub MUST be exactly:
#   https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_CALLBACK_BASE_URL=https://api-staging.foresightnine.com/oauth/callback
FORESIGHTNINE_OAUTH_RETURN_URI_ALLOWLIST=https://staging.foresightnine.com/oauth/mobile-callback,foresightnine://oauth/complete
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_ID=
FORESIGHTNINE_OAUTH_GOOGLE_CLIENT_SECRET=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_ID=
FORESIGHTNINE_OAUTH_GITHUB_CLIENT_SECRET=

# --- Model wire protocol (server-side credentials only) ---
# Replace these placeholders with an authorized deployment and its matching host.
FORESIGHTNINE_LLM_PROVIDER=openai_chat_completions
FORESIGHTNINE_LLM_BASE_URL=https://example.test/v1
FORESIGHTNINE_LLM_MODEL=example-deployment
FORESIGHTNINE_LLM_ALLOWED_HOSTS=example.test
# Request timeout is a transport boundary, not a research run budget.
FORESIGHTNINE_LLM_TIMEOUT_SECONDS=120
# Set native_tools true only after verifying support for this exact deployment.
# The endpoint is the full chat completions URL. Unknown capability fails closed.
FORESIGHTNINE_LLM_ENDPOINT_VERSION=deployment-v1
FORESIGHTNINE_LLM_CAPABILITY_PROFILE='{"endpoint":"https://example.test/v1/chat/completions","model":"example-deployment","version":"deployment-v1","mode":"json_object","native_tools":true,"generation_parameters":["temperature"],"continuation":false}'
# Optional profile fields (enable only after verifying endpoint protocol support):
#   "context_tokens": 200000        # admission/billing upper bound
#   "work_context_tokens": 128000   # working window for in-turn L1 compaction watermark
#   "explicit_cache_control": true  # emit ephemeral cache_control markers on stable prefix
# Values are sent only for parameter names explicitly allowed by the profile.
# Private extensions may likewise be explicitly named when supported.
FORESIGHTNINE_LLM_GENERATION_PARAMETERS='{"temperature":0.2}'
# For a protocol requiring an opaque assistant continuation field, set
# continuation=true and continuation_fields to the verified field names.
# Do not include sensitive reasoning fields unless needed for continuation.
# Research model/search/token/time/cost budgets are optional request settings.
# Absent budgets are not automatically assigned. Model capacity is unknown
# unless supported by an exact endpoint/model/version capability profile.
# Optional model-call business quota; unset disables it, zero blocks calls.
# FORESIGHTNINE_MODEL_CALL_QUOTA=0
FORESIGHTNINE_LLM_API_KEY=
# Account-owned BYOK credentials are encrypted with this independently rotated
# deployment secret; without it personal mode fails closed.
FORESIGHTNINE_MODEL_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/foresightnine-model-credential-encryption.key

# --- Android App Link (production release certificate) ---
FORESIGHTNINE_ANDROID_APP_LINK_PACKAGE=com.foresightnine.mobile
FORESIGHTNINE_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AA:BB:...:CC (release cert SHA-256)

# --- Market data providers (optional licensed server keys; fail closed when empty) ---
FORESIGHTNINE_MARKET_CONSENSUS_MODE=priority
FORESIGHTNINE_STOOQ_API_KEY=
FORESIGHTNINE_MARKETDATA_API_KEY=
FORESIGHTNINE_ALPHAVANTAGE_API_KEY=
# Optional comma-separated rotation set for server-side Alpha Vantage keys.
FORESIGHTNINE_ALPHAVANTAGE_API_KEYS=
FORESIGHTNINE_TWELVEDATA_API_KEY=
# A-share structured data (Tushare Pro). Used only when the fin_data policy allows tushare for credential_owner
# "platform" (see the policy example below); otherwise accounts use their own token from Settings. BaoStock needs no key.
FORESIGHTNINE_TUSHARE_TOKEN=
# Tushare and BaoStock are reachable only from mainland China networks (or via a proxy). A TCP probe (cached) skips
# them fast when unreachable; Yahoo Finance daily bars are the policy-gated fallback (see the policy example B).
# FORESIGHTNINE_CN_PROBE_TIMEOUT_SECONDS=5
# FORESIGHTNINE_CN_PROBE_CACHE_SECONDS=600
# FORESIGHTNINE_YAHOO_MIN_INTERVAL_SECONDS=2
# Data policy. FORESIGHTNINE_FIN_DATA_POLICY REPLACES the whole built-in default (SEC rules included), so any value
# must be complete. Example A: the built-in default written out explicitly (SEC allowed incl. export; twelve_data and
# tushare platform keys denied, user_byok keys allowed owner-scoped without export; twelve_data ASX no display;
# baostock allowed without export; yahoo bars_daily denied: license_terms_restrict_commercial_use). Leave it unset to get exactly this.
# FORESIGHTNINE_FIN_DATA_POLICY='{"version":"explicit-default","rules":[{"provider":"sec_edgar","category":"identity","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"filings","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"financials","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"ownership","store":true,"display":true,"model_input":true,"export":true},{"provider":"twelve_data","category":"identity","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"twelve_data","category":"bars_daily","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"twelve_data","category":"bars_intraday","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"twelve_data","category":"identity","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_daily","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_intraday","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_daily","exchange":"ASX","store":true,"display":false,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_intraday","exchange":"ASX","store":true,"display":false,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"identity","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"tushare","category":"bars_daily","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"tushare","category":"financials","credential_owner":"platform","deny":true,"deny_reason":"license_platform_key_not_permitted"},{"provider":"tushare","category":"identity","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"bars_daily","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"financials","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"baostock","category":"identity","store":true,"display":true,"model_input":true},{"provider":"baostock","category":"bars_daily","store":true,"display":true,"model_input":true},{"provider":"baostock","category":"financials","store":true,"display":true,"model_input":true},{"provider":"yahoo","category":"bars_daily","deny":true,"deny_reason":"license_terms_restrict_commercial_use"}]}'
# Example B: PERSONAL DEVELOPMENT USE ONLY; REMOVE BEFORE PUBLIC RELEASE. twelve_data platform key allowed,
# tushare platform token allowed (takes effect only when FORESIGHTNINE_TUSHARE_TOKEN is set), baostock and SEC allowed.
# Yahoo Finance daily bars (A-shares and Hong Kong; terms forbid commercial/automated use) allowed without export.
# Twelve Data free/individual plans and Tushare tokens are personal, non-commercial use.
# FORESIGHTNINE_FIN_DATA_POLICY='{"version":"dev-personal-platform-key","rules":[{"provider":"sec_edgar","category":"identity","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"filings","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"financials","store":true,"display":true,"model_input":true,"export":true},{"provider":"sec_edgar","category":"ownership","store":true,"display":true,"model_input":true,"export":true},{"provider":"twelve_data","category":"identity","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"twelve_data","category":"identity","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_daily","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"twelve_data","category":"bars_daily","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"twelve_data","category":"bars_intraday","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"twelve_data","category":"bars_intraday","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"identity","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"tushare","category":"bars_daily","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"tushare","category":"financials","credential_owner":"platform","store":true,"display":true,"model_input":true},{"provider":"tushare","category":"identity","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"bars_daily","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"tushare","category":"financials","credential_owner":"user_byok","store":true,"display":true,"model_input":true,"owner_scoped":true},{"provider":"baostock","category":"identity","store":true,"display":true,"model_input":true},{"provider":"baostock","category":"bars_daily","store":true,"display":true,"model_input":true},{"provider":"baostock","category":"financials","store":true,"display":true,"model_input":true},{"provider":"yahoo","category":"bars_daily","store":true,"display":true,"model_input":true,"export":false}]}'
# Personal development only: release cninfo/SSE/SZSE for single documents the user supplies themselves
# (no crawling; leads found by the agent stay non-acquirable). See app/research_source_terms.py.
# FORESIGHTNINE_SOURCE_TERMS_OVERRIDES='[{"host":"cninfo.com.cn","status":"user_initiated_only","permission_reference":"personal non-commercial use, user-initiated single documents"},{"host":"sse.com.cn","status":"user_initiated_only","permission_reference":"personal non-commercial use, user-initiated single documents"},{"host":"szse.cn","status":"user_initiated_only","permission_reference":"personal non-commercial use, user-initiated single documents"}]'
FORESIGHTNINE_FINNHUB_API_KEY=
# Mounted file path only; the key material stays outside the repository.
FORESIGHTNINE_MARKET_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/foresightnine-market-credential-encryption.key

# Optional independent Messages research deployment. Leave protocol unset for
# existing Chat routing. All placeholders must be replaced before enabling.
# FORESIGHTNINE_RESEARCH_MODEL_PROTOCOL=anthropic_messages
# FORESIGHTNINE_RESEARCH_LLM_BASE_URL=https://research-model.example/v1
# FORESIGHTNINE_RESEARCH_LLM_MODEL=deployment-model-id
# FORESIGHTNINE_RESEARCH_LLM_API_KEY=inject-from-secret-store
# FORESIGHTNINE_RESEARCH_LLM_ALLOWED_HOSTS=research-model.example
# FORESIGHTNINE_RESEARCH_LLM_CREDENTIAL_REVISION=credential-version
# For research models with FORESIGHTNINE_RESEARCH_MAX_OUTPUT_TOKENS >= 8192, set
# timeout >= 240s (e.g. 300s) alongside stream idle timeout so long responses do not abort mid-stream.
# FORESIGHTNINE_RESEARCH_LLM_TIMEOUT_SECONDS=300
# FORESIGHTNINE_RESEARCH_MAX_OUTPUT_TOKENS=1024
# FORESIGHTNINE_LLM_STREAM_IDLE_TIMEOUT_SECONDS=45
# Model requests that fail before any byte is sent (DNS, TCP or TLS) are retried
# automatically; requests that may have reached the provider are never retried.
# Defaults: 4 retries, waits of 1, 2, 4 and 8 seconds (each wait capped at 8 s).
# FORESIGHTNINE_RESEARCH_PRESEND_RETRIES=4
# FORESIGHTNINE_RESEARCH_PRESEND_RETRY_BASE_SECONDS=1
# Connection (TCP + TLS) and response limits for model requests, for both the
# OpenAI-compatible and the Messages transports. Defaults: 15 s connect, no
# separate response limit (the per-request timeout applies).
# FORESIGHTNINE_LLM_CONNECT_TIMEOUT_SECONDS=15
# FORESIGHTNINE_LLM_RESPONSE_TIMEOUT_SECONDS=
# FORESIGHTNINE_MESSAGES_VERSION=protocol-version
# FORESIGHTNINE_MESSAGES_AUTH_SCHEME=bearer
# FORESIGHTNINE_MESSAGES_NATIVE_TOOLS=true
# FORESIGHTNINE_MESSAGES_CONTINUATION=true
# Capability declaration must match exact configured endpoint, model and version.
# FORESIGHTNINE_MESSAGES_CAPABILITY_BASE_URL=https://research-model.example/v1
# FORESIGHTNINE_MESSAGES_CAPABILITY_MODEL=deployment-model-id
# FORESIGHTNINE_MESSAGES_CAPABILITY_VERSION=protocol-version
# Optional exact personal endpoint permission; capability match still required.
# FORESIGHTNINE_MESSAGES_PERSONAL_BASE_URL=https://research-model.example/v1

# Historical-price evidence is separate from market snapshots. Enable only with
# documented rights for storage, model processing, and display; enable export
# only if covered. Declare exact eligible instruments and provider identifiers.
# FORESIGHTNINE_RESEARCH_HISTORICAL_PRICES={"provider":"twelve_data","authorized":false,"permissions":{"store":false,"model_input":false,"display":false,"export":false},"instruments":[]}

# Document store and OCR. FORESIGHTNINE_DOCUMENT_STORE_DIR (set by compose to the
# foresightnine-documents volume) enables retaining large PDF originals and the
# OCR cache; unset keeps originals unretained. No retention/deletion policy yet.
# FORESIGHTNINE_DOCUMENT_STORE_DIR=/data/documents
# Local Tesseract is the default OCR engine. Ingestion OCRs up to N needs_ocr pages
# (earliest first) within the time budget.
# FORESIGHTNINE_OCR_DEFAULT_LANGS=eng
# FORESIGHTNINE_OCR_WORKERS=2
# FORESIGHTNINE_OCR_INGEST_MAX_PAGES=30
# FORESIGHTNINE_OCR_INGEST_SECONDS=90
# FORESIGHTNINE_OCR_FALLBACK_CONFIDENCE=70
# Optional vision-model OCR fallback (low-confidence pages, tables, missing
# languages). Disabled unless protocol, base URL, model and key are all set; its
# token usage is reported. Host must be in FORESIGHTNINE_OCR_VISION_ALLOWED_HOSTS
# (falls back to FORESIGHTNINE_RESEARCH_LLM_ALLOWED_HOSTS).
FORESIGHTNINE_OCR_VISION_PROTOCOL=
FORESIGHTNINE_OCR_VISION_BASE_URL=
FORESIGHTNINE_OCR_VISION_MODEL=
FORESIGHTNINE_OCR_VISION_API_KEY=
FORESIGHTNINE_OCR_VISION_MAX_OUTPUT_TOKENS=
# FORESIGHTNINE_OCR_VISION_ALLOWED_HOSTS=
# FORESIGHTNINE_OCR_VISION_ANTHROPIC_VERSION=   (falls back to FORESIGHTNINE_MESSAGES_VERSION)
