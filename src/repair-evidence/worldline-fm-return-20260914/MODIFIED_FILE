interface LanguageContextValue {
  readonly language: Language;
  readonly setLanguage: (language: Language) => void;
}

const fallbackContext: LanguageContextValue = { language: "zh", setLanguage: () => undefined };
const LanguageContext = createContext<LanguageContextValue>(fallbackContext);

export function LanguageProvider({ language, setLanguage, children }: PropsWithChildren<LanguageContextValue>) {
  return <LanguageContext.Provider value={{ language, setLanguage }}>{children}</LanguageContext.Provider>;
}

export function useLanguage(): LanguageContextValue {
  return useContext(LanguageContext);
}

export function t(language: Language, value: string): string {
  if (language !== "en") return value;
  const exact = english[value];
  if (exact) return exact;

  // Only translate the fixture wrapper around user-provided text. The premise
  // itself remains verbatim so a user's meaning is never silently rewritten.
  const wrapped = /^「(.+)」中的传导低于预期，订单或需求延后。$/.exec(value);
  if (wrapped) return `Transmission from “${wrapped[1]}” is below expectations, delaying orders or demand.`;
  const partial = /^「(.+)」按部分路径兑现，设备与基础设施投资逐步验证。$/.exec(value);
  if (partial) return `“${partial[1]}” plays out along part of its path, with equipment and infrastructure investment progressively verified.`;
  const secondOrder = /^「(.+)」触发二阶效应，政策与融资共同加速扩容。$/.exec(value);
  if (secondOrder) return `“${secondOrder[1]}” triggers second-order effects as policy and financing accelerate expansion together.`;
  return value;
}
