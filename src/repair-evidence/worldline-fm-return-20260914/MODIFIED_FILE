    expect(reducer(state, { type: "set_stage", stage: "worldline" }).stage).toBe("challenge");
    state = reducer(state, { type: "challenge_complete" });
    state = reducer(state, { type: "submit_reply", body: "我会使用公开订单数据验证这条路径。" });
