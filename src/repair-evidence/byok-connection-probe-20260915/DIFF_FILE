+    calls = 0
+
+    def transport(*_args: object) -> HttpResponse:
+        nonlocal calls
+        calls += 1
+        return HttpResponse(401, "")
+
+    assert provider(monkeypatch, transport).connection_ready() is False
+    assert calls == 2
+
